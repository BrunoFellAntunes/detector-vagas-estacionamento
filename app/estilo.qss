QWidget { font-family: "Manrope"; font-size: 13px; color: #253b50; }
QMainWindow, QWidget#root { background: #eef2f7; }
QFrame#sidebar { background: #162d4b; border-right: 1px solid #162d4b; }
QLabel#brand { font-family: "Sora"; font-size: 32px; font-weight: 700; color: #ffffff; }
QLabel#brand_note { color: #b8c8e3; font-size: 12px; }
QFrame#sidebar QLabel#section_title { color: #f0f5ff; font-size: 12px; }
QFrame#sidebar QLabel#small { color: #b8c8e3; font-size: 12px; }
QLabel#heading { font-family: "Sora"; font-size: 26px; font-weight: 600; color: #192f49; }
QLabel#subtitle { color: #52677e; font-size: 13px; }
QLabel#section_title { font-family: "Sora"; font-size: 14px; font-weight: 600; color: #223a53; }
QLabel#muted { color: #596d82; font-size: 12px; }
QLabel#small { color: #526681; font-size: 12px; }
QLabel#notice { color: #3e5775; font-size: 12px; }
QFrame#metrics, QFrame#video_panel, QFrame#spaces_panel, QFrame#about_panel { background: #ffffff; border-radius: 14px; }
QLabel#metric_free, QLabel#metric_occupied, QLabel#metric_unknown { font-family: "Sora"; font-size: 40px; font-weight: 600; }
QLabel#metric_free { color: #19734f; }
QLabel#metric_occupied { color: #b34f48; }
QLabel#metric_unknown { color: #966719; }
QLabel#metric_label { color: #425a74; font-size: 13px; }
QFrame#divider { background: #e2e8f1; max-width: 1px; }
QLabel#source_badge { color: #425b77; background: #edf2f8; padding: 5px 8px; border-radius: 5px; font-size: 11px; }
QLabel#selection_detail { color: #425b77; background: #f1f5fb; padding: 10px; border-radius: 8px; font-size: 12px; }
QPushButton { background: #ffffff; border: 2px solid #dbe3ee; border-radius: 8px; padding: 8px 11px; font-weight: 600; min-height: 20px; }
QPushButton:hover { background: #edf2fc; border-color: #b9c9e3; }
QPushButton:pressed { background: #dfe8f9; }
QPushButton:checked { background: #edf2ff; border-color: #b3c3ef; color: #294bc1; }
QPushButton:focus { border-color: #486bd5; }
QPushButton:disabled { color: #8290a3; background: #e9edf3; border-color: #e2e7ef; }
QPushButton[role="primary"] { background: #355bd5; border-color: #355bd5; color: #ffffff; }
QPushButton[role="primary"]:hover { background: #284ac1; border-color: #284ac1; }
QPushButton[role="primary"]:disabled { background: #91a5d9; border-color: #91a5d9; }
QPushButton[role="ghost"] { background: transparent; border-color: transparent; }
QPushButton[role="ghost"]:hover { background: #e0e8f7; }
QPushButton[role="nav"] { text-align: left; background: transparent; border: 2px solid transparent; color: #c5d3ea; padding: 11px 10px; }
QPushButton[role="nav"]:checked { background: #294b77; border-color: #294b77; color: #ffffff; }
QPushButton[role="nav"]:hover { background: #223f63; border-color: #223f63; color: #ffffff; }
QPushButton[role="nav"]:focus { border-color: #a4c2ff; }
QPushButton[role="space"] { text-align: left; border: 2px solid #e5ebf3; padding: 5px 8px; min-height: 28px; }
QPushButton[role="space"]:hover { border-color: #b9c9e3; background: #f5f8fd; }
QPushButton[role="space"][selected="true"] { border-color: #5271d7; background: #edf2ff; }
QPushButton[role="ghost"]:focus, QPushButton[role="space"]:focus { border-color: #355bd5; }
QPushButton[role="space"][selected="true"]:focus { border-color: #173a7a; background: #e1eaff; }
QPushButton[role="primary"]:focus { border-color: #173a7a; background: #284ac1; }
QLabel#space_id { font-family: "Sora"; font-size: 14px; font-weight: 600; color: #27415f; background: transparent; }
QLabel#space_state { color: #596d82; background: #edf1f6; padding: 3px 7px; border-radius: 5px; font-weight: 600; font-size: 12px; }
QLabel#space_state[state="livre"] { color: #19734f; background: #e9f5ee; }
QLabel#space_state[state="ocupada"] { color: #a43f39; background: #fcecea; }
QLabel#space_state[state="indefinida"] { color: #855914; background: #fff3d9; }
QComboBox { border: 2px solid #dbe3ee; border-radius: 7px; background: #f8faff; padding: 7px 9px; min-height: 16px; }
QComboBox:hover { border-color: #aabddd; }
QComboBox:focus { border-color: #486bd5; }
QComboBox::drop-down { border: 0; width: 22px; }
QComboBox::down-arrow { image: url("@APP_ROOT@/icons/chevron.svg"); width: 12px; height: 12px; }
QComboBox QAbstractItemView { background: #ffffff; color: #253b50; selection-background-color: #e2ebff; selection-color: #203e77; border: 1px solid #d1dcec; padding: 5px; }
QSlider { border: 1px solid transparent; border-radius: 5px; }
QSlider::groove:horizontal { height: 5px; background: #dfe6f1; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #4264d3; border-radius: 2px; }
QSlider::handle:horizontal { width: 13px; margin: -5px 0; background: #355bd5; border: 2px solid #ffffff; border-radius: 8px; }
QSlider::handle:horizontal:hover { background: #183cba; }
QSlider:focus { border-color: #6988dc; }
QListWidget#history { background: transparent; border: 2px solid transparent; border-radius: 8px; outline: 0; font-size: 12px; color: #c5d3ea; }
QListWidget#history::item { padding: 8px 4px; border-bottom: 1px solid #35506f; }
QListWidget#history::item:selected { background: #35557e; color: #ffffff; border-radius: 6px; }
QListWidget#history::item:hover { background: #294566; }
QListWidget#history:focus { border-color: #a4c2ff; }
QProgressBar { border: 0; background: #dce5f5; border-radius: 3px; max-height: 5px; }
QProgressBar::chunk { background: #355bd5; border-radius: 3px; }
QTextBrowser { background: transparent; border: 0; padding: 12px; selection-background-color: #dce7ff; }
QScrollBar:vertical { width: 8px; background: transparent; margin: 2px; }
QScrollBar::handle:vertical { background: #bdcbdf; border-radius: 3px; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
